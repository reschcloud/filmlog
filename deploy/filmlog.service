[Unit]
Description=Filmlog - Analoges Aufnahmeprotokoll
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=FILMLOG_CERT_FILE=/etc/ssl/srv3-hel1.resch.cloud.crt
Environment=FILMLOG_KEY_FILE=/etc/ssl/srv3-hel1.resch.cloud_key.pem
ExecStart=__VENV_DIR__/bin/python __APP_DIR__/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
